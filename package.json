{
  "name": "nothing-but-photos",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix .",
    "e2e": "npx playwright test",
    "e2e:dev": "npx playwright test --ui",
    "generate-og-img": "node ./scripts/screenshot.mjs",
    "og": "concurrently -k \"npm run dev\" \"npm run generate-og-img\" || exit 0",
    "prepare": "husky install"
  },
  "lint-staged": {
    "./src/assets/photos/*.jpg": [
      "npm run og"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^4.4.1",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.2.8",
    "@nanostores/react": "^1.0.0",
    "@react-spring/web": "^10.0.3",
    "@use-gesture/react": "^10.3.1",
    "astro": "^5.15.3",
    "astro-imagetools": "^0.9.0",
    "color": "^5.0.2",
    "exif-reader": "^2.0.2",
    "lodash.debounce": "^4.0.8",
    "lodash.kebabcase": "^4.1.1",
    "nanostores": "^1.0.1",
    "react-use-measure": "^2.1.7",
    "sharp": "^0.32.5",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/exif-reader": "^1.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "concurrently": "^9.2.1",
    "eslint": "^8.48.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "jsdom-testing-mocks": "^1.16.0",
    "lint-staged": "^16.2.6",
    "puppeteer-core": "^24.28.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
